# Koneksi MySQL: mysql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL="mysql://po_app:ganti_password@127.0.0.1:3306/po_system"
# Rahasia JWT, minimal 32 karakter acak. Buat dengan: openssl rand -hex 32
JWT_SECRET="ganti_dengan_string_acak_panjang"
JWT_EXPIRES_IN="8h"
PORT=4000
# Produksi: 127.0.0.1 (API hanya lewat Nginx)
HOST=0.0.0.0
NODE_ENV=development
# Origin frontend saat development (Vite). Di produksi frontend & API satu domain via Nginx.
CORS_ORIGIN="http://localhost:5173"
# Folder penyimpanan file upload (bukti transfer, logo, TTD)
UPLOAD_DIR="./storage/uploads"
# Akun Super Admin awal yang dibuat oleh seed
SEED_ADMIN_EMAIL="admin@example.com"
SEED_ADMIN_PASSWORD="GantiPassword123!"
